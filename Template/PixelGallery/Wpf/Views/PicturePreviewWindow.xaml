<Window x:Class="Wpf.Views.PicturePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Wpf.ViewModels;assembly=Wpf.ViewModels"
        xmlns:controls="clr-namespace:Wpf.Controls"
        d:DataContext="{d:DesignInstance Type=viewModels:PicturePreviewViewModel}"
        mc:Ignorable="d"
        Title="Picture Preview" Height="520" Width="640" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <!-- header -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding Picture.Name}" FontSize="20" FontWeight="Bold" />
            <TextBlock Foreground="DimGray" Margin="0,2,0,8">
                <Run Text="{Binding Picture.Description, Mode=OneWay}" />
                <Run Text=" | by " />
                <Run Text="{Binding ArtistName, Mode=OneWay}" />
                <Run Text=" | " />
                <Run Text="{Binding Picture.CreatedOn, Mode=OneWay, StringFormat=yyyy-MM-dd}" />
                <Run Text=" | " />
                <Run Text="{Binding Picture.Width, Mode=OneWay}" /><Run Text="x" /><Run Text="{Binding Picture.Height, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <!-- footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Width="90" Margin="0" Command="{Binding CloseCommand}" />
            <CheckBox Content="Show grid" IsChecked="{Binding ShowGrid}" VerticalAlignment="Center" />
        </DockPanel>

        <!-- color legend -->
        <DockPanel DockPanel.Dock="Right" Width="170" Margin="10,0,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Colors" FontWeight="Bold" Margin="0,0,0,4" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <!-- TODO (Task 3): ItemsControl with DataTemplate for ColorUsages
                     (color swatch, name, number of pixels) -->
                <TextBlock Text="TODO" Foreground="Red" />
            </ScrollViewer>
        </DockPanel>

        <!-- custom draw -->
        <Border BorderBrush="Black" BorderThickness="1" Background="White">
            <controls:PicturePreviewControl Margin="8"
                                            Strokes="{Binding Strokes}"
                                            ShowGrid="{Binding ShowGrid}"
                                            PictureWidth="{Binding Picture.Width}"
                                            PictureHeight="{Binding Picture.Height}" />
        </Border>
    </DockPanel>
</Window>
